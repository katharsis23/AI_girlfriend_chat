classDiagram
direction TB

%% ==========================================================================
%%  AI Girlfriend / Companion Framework — class diagram (as implemented)
%%  Package root: src.ai_girlfriend
%% ==========================================================================

%% ===== Configuration =====
class Config {
  <<pydantic-settings>>
  +provider: Literal~ollama, deepseek~
  +llm_url: str
  +model: str
  +api_key: SecretStr?
  +context_window: int
  +request_timeout: float
  +temperature: float
  +max_tokens: int
  +database_provider: Literal~sqlite, postgresql~
  +database_url: str
  +characters: list~CharacterInfo~
  +settings_customise_sources() sources
}

class CharacterInfo {
  +name: str
  +personality: str
  +greeting_message: str
  +photo_emoji_map: dict
  +initial_expression: str
  +temperature: float?
  +max_tokens: int?
  +schema_version: int
  +character_id: str
  +expressions: dict
  +available_emotions: list~str~
  +system_prompt: str
  +generation_params(temperature, max_tokens, provider) dict
}

%% ===== Composition root =====
class CompositionRoot {
  -config: Config
  +build_pipeline(character) GfPipeline
  -_select_character() CharacterInfo
}

%% ===== Facade =====
class GfPipeline {
  +gf_config: CharacterInfo
  +ai_controller: AIController
  +memory_manager: MemoryManager
  +expression_manager: ExpressionManager
  +default_temperature: float?
  +default_max_tokens: int?
  +init() async
  +chat(message, chat_id) async CharacterResponse
  +stream_chat(message, chat_id) AsyncIterator~StreamEvent~
  +list_chats(limit) async list~ChatSummary~
  +get_messages(chat_id) async list~Message~
  +close() async
  -_build_request(context_messages) GenerationRequest
  -_parse_response(raw) tuple~str, str?~
  -_ensure_chat(chat_id) async UUID
}

%% ===== LLM =====
class AIController {
  -provider: ILLMProvider
  -request_timeout: float?
  +generate(request) async GenerationResponse
  +stream(request) AsyncIterator~StreamEvent~
}

class LLMProviderFactory {
  +create_provider(provider_name, model, url, api_key) ILLMProvider
}

class ILLMProvider {
  <<Protocol>>
  +generate(request) async GenerationResponse
  +stream(request) AsyncIterator~StreamEvent~
}

class OllamaProvider {
  +provider = "ollama"
  +model: str
  +url: str
  +generate(request) async GenerationResponse
  +stream(request) AsyncIterator~StreamEvent~
}

class DeepSeekProvider {
  +provider = "deepseek"
  +model: str
  +api_key: str
  +generate(request) async GenerationResponse
  +stream(request) AsyncIterator~StreamEvent~
}

class FakeLLMProvider {
  <<testing>>
  +requests: list~GenerationRequest~
}

%% ===== Storage =====
class DatabaseController {
  -provider: IDatabaseStorage
  +init() async
  +create_chat() async UUID
  +save_message(message) async UUID
  +save_exchange(user_message, bot_message) async
  +get_recent_messages(chat_id, limit) async list~Message~
  +list_chats(limit) async list~ChatSummary~
  +get_messages(chat_id) async list~Message~
  +close() async
}

class DatabaseFactory {
  +create(provider, url) IDatabaseStorage
  -_normalize_url(url) Path
}

class IDatabaseStorage {
  <<Protocol>>
  +init() async
  +create_chat() async UUID
  +save_message(message) async UUID
  +save_exchange(user_message, bot_message) async
  +get_recent_messages(chat_id, limit) async list~Message~
  +list_chats(limit) async list~ChatSummary~
  +get_messages(chat_id) async list~Message~
  +close() async
}

class SQLiteProvider {
  +db_path: str
  +connection: aiosqlite.Connection
}

class InMemoryDatabaseProvider {
  <<testing>>
}

%% ===== Memory and context =====
class MemoryManager {
  -database: DatabaseController
  -context_provider: IContextProvider
  +create_chat() async UUID
  +build_context(chat_id, user_message) async ContextBundle
  +record_exchange(user_message, bot_message) async
  +list_chats(limit) async list~ChatSummary~
  +get_messages(chat_id) async list~Message~
}

class IContextProvider {
  <<Protocol>>
  +build_context(query, chat_id) async ContextBundle
}

class ConversationWindowProvider {
  -database: DatabaseController
  -window: int
}

class RAGContextProvider {
  <<optional / future>>
}

%% ===== Character =====
class ExpressionManager {
  -character: CharacterInfo
  -base_dir: Path?
  +resolve(expression_id) str
  +validate(expression_id)
  +asset_path(expression_id) Path
}

%% ===== Domain models =====
class Message {
  +id: UUID
  +conversation_id: UUID
  +role: Role
  +content: str
  +created_at: datetime
}

class Role {
  <<StrEnum>>
  SYSTEM
  USER
  ASSISTANT
}

class GenerationRequest {
  +messages: list~Message~
  +model: str
  +params: dict
  +metadata: dict
}

class GenerationResponse {
  +content: str
  +usage: dict
  +metadata: dict
}

class StreamEvent {
  <<discriminated union>>
  +TextDelta(type="text_delta")
  +Done(type="done")
  +Error(type="error")
}

class ContextBundle {
  +messages: list~Message~
  +memories: list~Memory~
}

class Memory {
  +content: str
  +source: str?
  +score: float?
}

class CharacterResponse {
  +text: str
  +expression: str
  +chat_id: UUID?
}

class Chat {
  +id: UUID
  +content: list~Message~
  +summary: Message?
  +updated_at: datetime
}

class ChatSummary {
  +id: UUID
  +updated_at: datetime
  +message_count: int
  +preview: str
}

%% ===== Errors =====
class CompanionError {
  <<exception>>
}
class ConfigError
class ProviderError
class GenerationTimeoutError
class StorageError
class InvalidExpressionError

%% ===== Local assistant (placeholder) =====
class ITool {
  <<Protocol>>
}
class ToolRegistry {
  +register()
  +get(name)
}

%% ===== Desktop adapters (outside the core) =====
class QtDesktopAdapter {
  +run()
}
class UIBuilder {
  +build(pipeline, config, argv) QApplication
}
class FastAPIAdapter {
  <<module: main.py>>
  +lifespan()
  +/chat
  +/chat/{chat_id}/message
  +/chat/{chat_id}
  +/chat/{chat_id}/stream
}

%% ===== QML UI bridge (PySide6) =====
class AsyncWorker {
  <<QThread>>
  +run()
  +start_and_wait()
  +submit(coro) Future
  +stop()
}
class ChatBackend {
  <<QObject>>
  +busy: bool
  +characterName: str
  +greeting: str
  +currentChatId: str
  +sendMessage(text)
  +resetChat()
  +expressionUrl(expression) str
  +listChats(limit)
  +loadChat(chat_id)
  +apply_character(pipeline, character)
}
class SettingsBackend {
  <<QObject>>
  +selectTheme(theme_id)
  +saveTheme(...)
  +deleteTheme(theme_id)
  +selectCharacter(character_id)
  +saveCharacter(data) str
  +deleteCharacter(character_id) bool
  +characterInfo(character_id) map
}
class FileSystemBackend {
  <<QObject>>
  +listDir(path) list
  +setCwd(path) bool
}
class ThemeController {
  <<QObject>>
  +colors: map
  +setTheme(theme_id)
  +saveCustomTheme(...)
  +deleteCustomTheme(theme_id)
}
class CharacterStore {
  +load() list~CharacterInfo~
  +save(characters)
}
class ThemeStore {
  +validate(...)
  +load() dict
  +save(themes)
}

%% ===== Relations: assembly =====
CompositionRoot --> Config : reads
CompositionRoot ..> LLMProviderFactory : uses
CompositionRoot ..> DatabaseFactory : uses
CompositionRoot ..> GfPipeline : builds

%% ===== Relations: core =====
GfPipeline --> CharacterInfo : reads
GfPipeline --> AIController
GfPipeline --> MemoryManager
GfPipeline --> ExpressionManager

AIController --> ILLMProvider : uses
LLMProviderFactory ..> ILLMProvider : creates
ILLMProvider <|.. OllamaProvider
ILLMProvider <|.. DeepSeekProvider
ILLMProvider <|.. FakeLLMProvider

DatabaseController --> IDatabaseStorage : uses
DatabaseFactory ..> IDatabaseStorage : creates
IDatabaseStorage <|.. SQLiteProvider
IDatabaseStorage <|.. InMemoryDatabaseProvider

MemoryManager --> DatabaseController : uses
MemoryManager --> IContextProvider : uses
IContextProvider <|.. ConversationWindowProvider
IContextProvider <|.. RAGContextProvider
ConversationWindowProvider --> DatabaseController : reads history

ExpressionManager --> CharacterInfo : validates against

%% ===== Relations: models =====
AIController ..> GenerationRequest
AIController ..> GenerationResponse
ILLMProvider ..> StreamEvent
GfPipeline ..> CharacterResponse
GfPipeline --> GenerationRequest : builds
IContextProvider ..> ContextBundle
GenerationRequest o-- Message
ContextBundle o-- Message
ContextBundle o-- Memory
Message --> Role
Chat o-- Message
IDatabaseStorage ..> ChatSummary

%% ===== Relations: errors =====
CompanionError <|-- ProviderError
CompanionError <|-- StorageError
CompanionError <|-- ConfigError
CompanionError <|-- InvalidExpressionError
ProviderError <|-- GenerationTimeoutError

%% ===== Relations: tools =====
ToolRegistry o-- ITool

%% ===== Relations: adapters =====
QtDesktopAdapter --> UIBuilder : uses
UIBuilder ..> GfPipeline : consumes
FastAPIAdapter ..> GfPipeline : consumes

%% ===== Relations: QML UI =====
ChatBackend --> AsyncWorker : submits coroutines
ChatBackend ..> GfPipeline : consumes
SettingsBackend --> AsyncWorker : submits coroutines
SettingsBackend ..> CompositionRoot : rebuilds pipeline
SettingsBackend --> CharacterStore : persists
SettingsBackend --> ThemeController : manages
ThemeController --> ThemeStore : persists
FileSystemBackend ..> ChatBackend : image picker support

